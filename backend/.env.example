# Copy to .env and fill in. .env is gitignored.

ENVIRONMENT=development

# Matches the credentials in ../docker-compose.yml
DATABASE_URL=postgresql+asyncpg://futurequest:futurequest@localhost:5432/futurequest

# Signs the session cookie. Any long random string for local dev.
SESSION_SECRET=

# Every origin the app may be served from, comma-separated — the Vite dev server, plus any
# tunnel or staging domain. CORS, the Google redirect URI and the post-sign-in redirect are all
# chosen from this list by matching the incoming request, so deploying somewhere new means
# adding it here and in the Google console, and changing nothing else.
#
# The first entry is canonical: it's the link used in emails, which are sent with no request
# to learn from.
ALLOWED_ORIGINS=http://localhost:5173

# Filled in as each integration is wired up. Left blank, the app starts fine
# and the corresponding feature is simply unavailable.
# Optional. Without these, sign-in is unavailable and everything else works; the login route
# returns 503. The redirect URI isn't configured here — it's derived as
# <origin>/api/auth/google/callback for whichever ALLOWED_ORIGINS entry the request matches.
# Register one authorized redirect URI in the Google console per entry in that list.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe. All three are optional: with none of them set, the app starts, the paywall still
# holds, and the checkout route returns 503 naming whichever one is missing.
#
# STRIPE_SECRET_KEY is the secret key from the Stripe dashboard (sk_test_... in test mode).
# STRIPE_PRICE_ID is the id of the Price the report is sold at (price_...). The Price is
# authoritative — it is what the customer is actually charged.
# STRIPE_WEBHOOK_SECRET is the signing secret of the endpoint that delivers events to
# /api/stripe/webhook. It is NOT the same as the secret key, and using the wrong one fails
# every delivery: the symptom is a paid purchase that never grants access.
#
# The price below is what the paywall *displays*. It must match the Stripe Price, or the
# number shown is the wrong number. Changing it is a deploy.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
REPORT_PRICE_CENTS=2999
REPORT_PRICE_CURRENCY=usd
# Optional. Without a key, reports simply aren't emailed and nothing else changes.
#
# On the free tier with no verified domain, Resend only DELIVERS to the address that owns the
# account — mail to anyone else is accepted by the API and silently goes nowhere. Verify a
# domain before demoing this to someone who expects to receive one.
RESEND_API_KEY=
RESEND_FROM_EMAIL=FutureQuest <onboarding@resend.dev>
